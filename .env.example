# Google Gemini API Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Hugging Face API Configuration (Optional - for better rate limits on video generation)
# Get your API key from: https://huggingface.co/settings/tokens
# Leave empty to use free inference without authentication (slower, rate limited)
HUGGINGFACE_API_KEY=

# Image Generation Settings
# Model: imagen-3.0-generate-001 (via Vertex AI) or gemini-1.5-flash (for descriptions)
IMAGE_MODEL=imagen-3.0-generate-001

# Size options (standard sizes):
# 256x256, 512x512, 1024x1024
IMAGE_SIZE=1024x1024

# Number of images to generate
NUM_IMAGES=1

# Video Generation Settings (FREE via Hugging Face)
# Available models:
# - ali-vilab/text-to-video-ms-1.7b (recommended)
# - damo-vilab/text-to-video-ms-1.7b
# - cerspense/zeroscope_v2_576w (higher quality, slower)
VIDEO_MODEL=ali-vilab/text-to-video-ms-1.7b

# Video duration in seconds (2-8 seconds recommended for free tier)
VIDEO_DURATION=4

# Frames per second (8-16 recommended, higher = smoother but slower)
VIDEO_FPS=8

# Number of inference steps (15-50, higher = better quality but slower)
# 25 is a good balance
VIDEO_NUM_INFERENCE_STEPS=25

# Output directories
OUTPUT_DIR=generated_images
VIDEO_OUTPUT_DIR=generated_videos
